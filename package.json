{
  "name": "agency-website",
  "version": "1.0.0",
  "description": "Modern digital product agency website",
  "main": "index.html",
  "scripts": {
    "dev": "live-server --port=8000 --open=/index.html",
    "start": "npm run dev",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\"",
    "lint": "eslint script.js",
    "lint:fix": "eslint script.js --fix",
    "build": "npm run format && npm run lint:fix"
  },
  "keywords": [
    "agency",
    "website",
    "portfolio"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "live-server": "^1.2.2",
    "prettier": "^3.2.5",
    "eslint": "^8.57.0"
  },
  "dependencies": {}
}
